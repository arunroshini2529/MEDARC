# Copy this file to .env and fill in your values

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=verify-full

# GitHub OAuth App credentials (github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Random secret for signing session cookies (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=your_random_secret_here

# Your app's public URL (no trailing slash)
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
APP_URL=http://localhost:3000

PORT=3000
