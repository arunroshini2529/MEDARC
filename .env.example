# Copy this file to .env and fill in your Neon connection string
# Get DATABASE_URL from https://console.neon.tech → your project → Connection Details

PORT=3000
DATABASE_URL=postgresql://user:password@ep-xxxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=verify-full

# On Vercel: set DATABASE_URL in Project Settings → Environment Variables
# Do NOT commit your .env file — it is in .gitignore
